{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "alpine_small",
    "color": {
      "1": "38;2;85;205;175",
      "2": "38;2;245;100;75"
    },
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;85;205;175"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;85;205;175mSTRATEGICZNY TERMINAL OPERACYJNY\u001b[0m",
      "key": " "
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;245;100;75msystem\u001b[0m \u001b[90m────────────────────────────────────\u001b[0m",
      "key": " "
    },
    {
      "type": "os",
      "key": "  \u001b[38;2;85;205;175m OS    \u001b[0m"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;2;250;210;130m KERNEL\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;2;25;110;130m WM    \u001b[0m"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;2;210;50;80m TERM  \u001b[0m"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;2;245;100;75m󰈺 SHELL \u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;245;100;75mhardware\u001b[0m \u001b[90m──────────────────────────────────\u001b[0m",
      "key": " "
    },
    {
      "type": "cpu",
      "key": "  \u001b[38;2;250;210;130m󰻠 CPU   \u001b[0m"
    },
    {
      "type": "gpu",
      "key": "  \u001b[38;2;250;210;130m󰢮 GPU   \u001b[0m",
      "format": "{2}"
    },
    {
      "type": "display",
      "key": "  \u001b[38;2;25;110;130m󰍹 DISP  \u001b[0m"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;2;210;50;80m󰍛 RAM   \u001b[0m"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;2;250;210;130m󰋊 ROOT  \u001b[0m",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) [TMPFS]"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;2;250;210;130m󰋊 DATA  \u001b[0m",
      "folders": "/home",
      "format": "{size-used} / {size-total} [LUKS2·BTRFS]"
    },
    {
      "type": "swap",
      "key": "  \u001b[38;2;210;50;80m󰍛 SWAP  \u001b[0m",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "command",
      "key": "  \u001b[38;2;210;50;80m󰍛 ZSWAP \u001b[0m",
      "text": "printf '%s · zużycie: %s' \"$(cat /sys/module/zswap/parameters/compressor)\" \"$(awk '/^Zswap:/ {printf \"%.1f MiB\", $2/1024}' /proc/meminfo)\""
    },
    {
      "type": "battery",
      "key": "  \u001b[38;2;245;100;75m󰁹 BAT   \u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;245;100;75mworkspace\u001b[0m \u001b[90m─────────────────────────────────\u001b[0m",
      "key": " "
    },
    {
      "type": "compiler",
      "key": "  \u001b[38;2;85;205;175m GCC   \u001b[0m"
    },
    {
      "type": "command",
      "key": "  \u001b[38;2;250;210;130m󰣖 MUSL  \u001b[0m",
      "text": "v=$(strings /lib/libc.musl-x86_64.so.1 2>/dev/null | grep -o 'musl libc [0-9.]*' | head -1); printf '%s\\n' \"${v:-Nie wykryto}\""
    },
    {
      "type": "command",
      "key": "  \u001b[38;2;25;110;130m󰡨 DBOX  \u001b[0m",
      "text": "c=$(distrobox list --no-color 2>/dev/null | awk 'NR>1 {print $3}'); test -n \"$c\" && echo \"$c\" || echo 'Brak'"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square",
      "key": " "
    }
  ]
}
